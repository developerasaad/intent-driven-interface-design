{
  "name": "intent-driven-interface-design",
  "version": "0.1.0",
  "description": "Install a context-first interface design Agent Skill for OpenCode and compatible coding agents.",
  "type": "module",
  "bin": {
    "intent-driven-interface-design": "./bin/intent-driven-interface-design.mjs"
  },
  "files": [
    "bin/",
    "lib/",
    "skill/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {"node": ">=20"},
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "validate": "python3 skill/intent-driven-interface-design/scripts/validate_skill.py",
    "check": "npm run validate && npm test && npm pack --dry-run --json",
    "build:site": "node scripts/build-site.mjs"
  },
  "license": "MIT",
  "keywords": ["agent-skills", "opencode", "design", "ui", "frontend", "agents"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/developerasaad/intent-driven-interface-design.git"
  },
  "bugs": {"url": "https://github.com/developerasaad/intent-driven-interface-design/issues"},
  "homepage": "https://github.com/developerasaad/intent-driven-interface-design#readme",
  "publishConfig": {"access": "public"}
}
